{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineM",
  "version": "0.5.0-beta.1",
  "identifier": "com.minem.materialos",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "binaries/sidecar": "sidecar"
    }
  }
}
